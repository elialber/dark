{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": ["Bash(make teste)", "Read(./docs/**)"],
    "deny": ["Read(./.env)"],
    "ask": ["Bash(git push *)"]
  },
  "hooks": {
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "TOKEN_PROJETO=valor-secreto-hook ./verifica.sh", "timeout": 10}]}
    ],
    "Stop": [
      {"hooks": [{"type": "http", "url": "http://localhost:9/aviso", "headers": {"Authorization": "Bearer valor-secreto-cabecalho-hook"}, "allowedEnvVars": ["CHAVE_AVISO"]}]}
    ]
  },
  "enabledPlugins": {"plugin-desligado@mercado-exemplo": false}
}
